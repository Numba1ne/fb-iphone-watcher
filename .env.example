# Copy this file to .env and fill in your values. .env is gitignored.

# --- Telegram ---------------------------------------------------------------
# 1. Message @BotFather on Telegram, send /newbot, follow the prompts.
# 2. Copy the token it gives you here.
# 3. IMPORTANT: open a chat with your new bot and send it any message.
#    A bot cannot start a conversation with you, so without this step it fails.
TELEGRAM_BOT_TOKEN=

# 4. Get your chat id: open this in a browser (with your real token):
#    https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#    Look for result[0].message.chat.id and paste the number.
TELEGRAM_CHAT_ID=

# --- Discord (optional) ------------------------------------------------------
# Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL.
DISCORD_WEBHOOK_URL=
